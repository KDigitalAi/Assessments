# Normalize text files to LF in the repository and working tree (avoids CRLF warnings on Windows).
* text=auto eol=lf

# Windows-only scripts that should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — do not modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
